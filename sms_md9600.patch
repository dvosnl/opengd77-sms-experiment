+			if (!EEPROM_Read((int32_t)fromAddress, (uint8_t *)&shiftedMessage, (int)sizeof(shiftedMessage)) ||
+				!EEPROM_Write((int32_t)toAddress, (uint8_t *)&shiftedMessage, (int)sizeof(shiftedMessage)))
