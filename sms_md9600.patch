+static uint16_t smsIpHeaderChecksum(const uint8_t *header, uint16_t length)
+{
+	uint32_t sum = 0U;
+
+	for (uint16_t i = 0U; i < length; i += 2U)
+	{
+		sum += ((uint32_t)header[i] << 8);
+		if ((i + 1U) < length)
+		{
+			sum += (uint32_t)header[i + 1U];
+		}
+	}
+
+	while ((sum >> 16) != 0U)
+	{
+		sum = (sum & 0xFFFFU) + (sum >> 16);
+	}
+
+	return (uint16_t)(~sum & 0xFFFFU);
+}
