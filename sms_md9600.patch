+
+	buffer[0] = 0;
+
+	if (codeplugContactIndexByTGorPC(sourceId, CONTACT_CALLTYPE_PC, &contact, 0) >= 0)
+	{
+		codeplugUtilConvertBufToString(contact.name, buffer, 16);
+	}
+
+	if (buffer[0] == 0)
+	{
+		snprintf(buffer, bufferLength, "%u", sourceId);
+	}
+}
