+static uint16_t smsCountCharOccurrence(const char *text, char value)
+{
+	uint16_t count = 0U;
+
+	if (text == NULL)
+	{
+		return 0U;
+	}
+
+	for (uint16_t i = 0U; text[i] != 0; i++)
+	{
+		if (text[i] == value)
+		{
+			count++;
+		}
+	}
+
+	return count;
+}
